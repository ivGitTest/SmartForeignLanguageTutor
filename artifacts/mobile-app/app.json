{
  "expo": {
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile-app",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.englishlab.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      ["expo-audio", { "microphonePermission": "Record your English speech for transcription.", "enableBackgroundRecording": false, "enableBackgroundPlayback": false }],
      ["expo-build-properties", { "android": { "minSdkVersion": 33, "usesCleartextTraffic": false } }],
      "./plugins/with-local-privacy"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
